# 시험 컨테이너 전용 새 경로 환경변수 — EC2 /home/ubuntu/maidol/cloudswitch/newpaths.env 로 복사 후 값 채우기(chmod 600).
# 운영 .env 는 건드리지 않는다. 시험 컨테이너에서만 --env-file 두 번째로 덮어쓴다.
CLAUDE_PROVIDER=vertex
GCP_PROJECT_ID=maidol-509006
VERTEX_REGION=global
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

GEMINI_VERTEX_RATIO=100
# 시험에서는 Vertex 자체를 확인하려고 예비 경로를 끈다(운영 전환 때는 true 로 둔다)
GEMINI_AISTUDIO_FALLBACK=false
VERTEX_API_KEY=
VERTEX_GEMINI_MODEL_MAP=gemini-3-pro-image-preview=gemini-3-pro-image

OPENAI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<리소스>.openai.azure.com
AZURE_OPENAI_API_KEY=

# 시험 컨테이너가 백그라운드 작업에 끼어들지 않게(lifespan off 와 이중 안전장치)
CS_WORKER_MODE=off
