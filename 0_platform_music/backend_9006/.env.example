# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=music_platform
POSTGRES_USER=music_user
POSTGRES_PASSWORD=music_pass_2024

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=music_platform
MONGO_USER=music_user
MONGO_PASSWORD=music_pass_2024

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=music_pass_2024

# Elasticsearch (2단계)
ES_HOST=localhost
ES_PORT=9200

# 검색 튜닝 (v171) — 아무말 게이트: ES lexical 앵커 없음(히트 0 또는 top1 <
# WEAK_SCORE) && vec_top1 < GIBBERISH_COSINE → 빈 결과
SEARCH_GIBBERISH_COSINE=0.34
SEARCH_ES_WEAK_SCORE=3.0

# MinIO
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_USER=music_minio
MINIO_PASSWORD=music_minio_pass_2024
MINIO_AUDIO_BUCKET=music-platform-audio
MINIO_IMAGE_BUCKET=music-platform-images

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI (ChatGPT - lyrics generation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# YuE Music Generation
YUE_MODEL_DIR=./yue_models
YUE_OUTPUT_DIR=./yue_output
YUE_VRAM_PROFILE=4
YUE_PYTHON=/path/to/conda/envs/yuegp/bin/python

# Replicate (deprecated as of v41 — LoRA system removed)
REPLICATE_API_TOKEN=

# Social OAuth (Authorization Code) — 각 콘솔(Google Cloud / Kakao Developers / Naver Developers)에서 발급
# Redirect URI 등록값: {OAUTH_CALLBACK_BASE}/api/auth/oauth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=http://localhost:9006
FRONTEND_URL=https://localhost:4000

# FaceGuardSquad(v135) — 얼굴 인증(생체 대조): AWS Rekognition CompareFaces(서울) + Face Liveness(도쿄)
# 키 빈값이면 mock 모드로 전체 플로우 동작. 기본 OFF.
FACE_VERIFY_ENABLED=false
AWS_FACE_ACCESS_KEY_ID=
AWS_FACE_SECRET_ACCESS_KEY=
FACE_COMPARE_REGION=ap-northeast-2
FACE_LIVENESS_REGION=ap-northeast-1
FACE_MATCH_THRESHOLD=90
# v136: Face Liveness confidence 하한(미만이면 liveness_failed — 재시도 유도)
FACE_LIVENESS_CONFIDENCE_THRESHOLD=80
# Fernet 키(저장 얼굴 암호화) — 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_DATA_KEY=
# 테스트용 강제 판정 (mock 모드 전용): off | match | mismatch
FACE_MOCK_FORCE=off

# CS/OfficialSquad — maidol_official 공식 계정 (CS 오류신고 DM 문의 채널).
# startup 에서 이 이메일로 시드(role=admin, is_verified=true) + 전체 유저 양방향 맞팔 백필.
# 비밀번호는 비워두면 랜덤 해시(로그인 불가 — DM 대응은 어드민 API 로만).
OFFICIAL_ACCOUNT_EMAIL=official@maidol.app
OFFICIAL_ACCOUNT_NICKNAME=maidol_official
OFFICIAL_ACCOUNT_PASSWORD=

# ReferralSquad(v154) — 앱 추천(리퍼럴) 착지 페이지의 플레이스토어 링크.
# 출시 후 실제 URL 로 교체 — 미설정(주석/키 삭제) 시 코드 기본 플레이스홀더 사용
PLAY_STORE_URL=

# =============================================================================
# v198 — 컨테이너 배포용 주입 키 목록 보완
# =============================================================================
# 아래는 실제 .env 에는 있으나 이 예시 파일에 빠져 있던 24개 키다. 컨테이너에
# `--env-file` 로 무엇을 주입해야 하는지가 문서로 남아 있지 않으면 배포 때
# 조용히 기능이 죽는다(대부분 코드 기본값이 localhost 이거나 빈 문자열이라
# 기동 자체는 성공한다).
# 🚫 실값은 절대 여기에 쓰지 않는다 — 이름과 빈 값, 설명만.

# --- Elasticsearch 인증 (보안 활성화된 클러스터일 때) ---
ES_USER=
ES_PASSWORD=

# --- MinIO / S3 (앱이 실제로 읽는 키. 위쪽 MINIO_USER/PASSWORD 와 별개) ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_MUSIC=
MINIO_BUCKET_IMAGES=
# 호스트 포트 매핑용(compose 에서 사용). 기본 9100
MINIO_API_PORT=
# 브라우저에 내려줄 미디어 URL 의 공개 호스트. 컨테이너 내부 주소가 아니다
MINIO_PUBLIC_HOST=
# https 로 서빙되면 true
MINIO_PUBLIC_SECURE=
# 미디어 URL 생성 방식 (presign / proxy 등)
MEDIA_URL_MODE=

# --- LLM / 생성 API 키 (전부 유료. 빈 값이면 해당 기능만 비활성) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# --- 음악 생성 / 오디오 처리 외부 서비스 ---
SUNO_API_URL=
SUNO_API_KEY=
WONDERA_API_KEY=

# --- 영상 / 이미지 생성 외부 서비스 ---
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
FAL_API_KEY=
# 립싱크(Sync Labs)
SYNC_API_KEY=

# --- 운영 ---
# /api/_logs/* 접근 토큰
LOG_ACCESS_TOKEN=
