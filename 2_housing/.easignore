*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo

# EAS 빌드에 불필요한 파일 (루트의 참고용 이미지, 문서)
*.md
*.py
