{
  "expo": {
    "name": "MAIDOL",
    "slug": "triplej-studio",
    "scheme": "aidol",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maidol.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a1a"
      },
      "package": "com.maidol.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1425041551318467~9961638197",
          "iosAppId": "ca-app-pub-1425041551318467~5404280238"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "만든 공유 영상을 사진 앨범에 저장하기 위해 접근 권한이 필요합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0a0a1a",
          "borderColor": "#0a0a1a",
          "buttonStyle": "light"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "974e9cc3-c829-4078-8e32-b9cd75d677a0"
      }
    }
  }
}
